# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=toeic_learningpath
MYSQL_PORT=3306

# Connection pool (optional – defaults shown)
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_CONNECT_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Gemini (primary LLM) ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash

# ─── Optional alternate LLM providers (leave blank if not used) ───────────────
OpenRouter=
Groq=
Mistral=
Nvidia=
HuggingFace=
Zen=
Google=

# ─── SSL ─────────────────────────────────────────────────────────────────────
# Set to True if you get CERTIFICATE_VERIFY_FAILED errors (e.g. corporate proxy)
DISABLE_SSL_VERIFY=False