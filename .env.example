# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=toeic_learningpath
MYSQL_PORT=3306

# Connection pool (optional – defaults shown)
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_CONNECT_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ─── Redis Caching ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AI providers ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_key_here
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro      # Generators C-1/C-2 (deep content)

# Runtime environment: development (default) enables dev-mode endpoints
# (skill-score override, roadmap lesson generate). Set to production to disable.
# APP_ENV=development

# ─── TLS trust store for outbound AI provider calls ──────────────────────────
# Set only when provider calls fail with CERTIFICATE_VERIFY_FAILED on this
# machine (e.g. a corporate/self-signed TLS terminator). Point at the CA that
# terminates TLS on the network:
#   SSL_CERT_FILE=C:\path\to\bundle.pem        # single PEM bundle
#   SSL_CERT_DIR=C:\path\to\certs              # directory of CA files (concatenated)
# When neither is set, the pool falls back to known system bundles, then certifi.
# SSL_CERT_FILE=
# SSL_CERT_DIR=
#
# Emergency bypass: DISABLE_SSL_VERIFY=true disables TLS verification entirely
# for all outbound calls (LLM providers, TTS, STT). Fixes
# CERTIFICATE_VERIFY_FAILED behind a corporate TLS terminator when no CA bundle
# is available, at the cost of MITM exposure.
# NEVER use this on a machine that handles production secrets.
# DISABLE_SSL_VERIFY=false
