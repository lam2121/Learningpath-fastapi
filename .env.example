MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=12345678x@X
MYSQL_DB=toeic_learningpath
MYSQL_PORT=3306

SECRET_KEY=my_super_secret_key_for_adaptive_learning_123!@#
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# TLS trust store for outbound AI provider calls.
# Set only when provider calls fail with CERTIFICATE_VERIFY_FAILED on this
# machine (e.g. a corporate/self-signed TLS terminator). Point at the CA that
# terminates TLS on the network:
#   SSL_CERT_FILE=C:\path\to\bundle.pem        # single PEM bundle
#   SSL_CERT_DIR=C:\path\to\certs              # directory of CA files (concatenated)
# When neither is set, the pool falls back to known system bundles, then certifi.
# SSL_CERT_FILE=
# SSL_CERT_DIR=
#
# Emergency bypass: SSL_VERIFY=false disables TLS verification entirely for
# provider calls. Fixes CERTIFICATE_VERIFY_FAILED behind a corporate TLS
# terminator when no CA bundle is available, at the cost of MITM exposure.
# NEVER use this on a machine that handles production secrets.
# SSL_VERIFY=true